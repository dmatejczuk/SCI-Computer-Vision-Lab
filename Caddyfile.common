(app) {
    root * /srv
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' {$SIGNALING_ORIGIN:ws://localhost}; media-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    @model path /models/*
    header @model Cache-Control "public, max-age=3600"
    @backend path /api/* /ws
    handle @backend {
        reverse_proxy signaling:3001
    }
    handle /phone {
        rewrite * /index.html
        header Cache-Control "no-store"
        file_server
    }
    handle {
        file_server
    }
}

http://:8080 {
    bind 127.0.0.1
    respond /health "ok" 200
}
