{
    admin off
    # IP clients omit SNI; Docker's internal address is not the public LAN address.
    default_sni {$APP_HOST}
}

import /etc/caddy/Caddyfile.common

# HTTPS_PORT (default 443) lets the app share a server; ACME still answers HTTP-01 on port 80.
https://{$APP_HOST}:{$HTTPS_PORT:443} {
    tls {
        issuer {$APP_TLS_ISSUER:internal}
    }
    import app
}
