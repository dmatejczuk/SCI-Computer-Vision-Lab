{
  "name": "ai-vision-challenge",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run verify:model && npm run verify:plates && tsc --noEmit && vite build && npm run build:server",
    "preview": "vite preview --host 0.0.0.0",
    "download:model": "node scripts/download-model.mjs",
    "verify:model": "node scripts/verify-model.mjs",
    "verify:plates": "node scripts/verify-plates.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev:signaling": "tsx server/index.ts",
    "build:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@techstark/opencv-js": "4.12.0-release.1",
    "@tensorflow/tfjs": "4.22.0",
    "@xyflow/react": "12.12.1",
    "opentype.js": "1.3.4",
    "phaser": "3.90.0",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/opentype.js": "1.3.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "4.1.11"
  }
}
